# Copy to .env (or .env.docker) and fill in.
# Every variable is read by src/dirt/settings.py.

# Required — generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Toggles (default: False)
DJANGO_DEBUG=False
DJANGO_DEPLOYED=False

# Comma-separated. Required when deploying behind a public hostname.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dirt.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dirt.example.org

# SQLite/SpatiaLite file locations (default: <repo>/db/dirt.db and a
# cache.sqlite3 next to it). Point these at a persistent volume in containers.
# DB=/app/db/dirt.db
# CACHE_DB=/app/db/cache.sqlite3

# Celery broker (default: local rabbitmq with guest credentials)
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# GeoDjango library discovery overrides (usually unnecessary under pixi)
# GDAL_LIBRARY_PATH=
# GEOS_LIBRARY_PATH=
# SPATIALITE_LIBRARY_PATH=
