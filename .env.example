# Copy to .env (or .env.docker) and fill in.
# Every variable is read by src/dirt/settings.py.

# Required — generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Toggles (default: False)
DJANGO_DEBUG=False
DJANGO_DEPLOYED=False

# Comma-separated. Required when deploying behind a public hostname.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dirt.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dirt.example.org

# SQLite file locations (default: <repo>/db/dirt.db and a cache.sqlite3 next to
# it). Point these at a persistent volume in containers.
# DB=/app/db/dirt.db
# CACHE_DB=/app/db/cache.sqlite3

# Rendered images live as files here (default: <repo>/media).
# MEDIA_ROOT=/app/media

# Serving under a path prefix behind a prefix-stripping proxy.
# DJANGO_FORCE_SCRIPT_NAME=/dirt

# Image-ingest API (default: follows DJANGO_DEBUG). See deploy/compose.yaml.
# DIRT_INGEST_ENABLED=1

# Push client defaults for `manage push` (password via DIRT_PUSH_PASSWORD or a
# prompt).
# DIRT_PUSH_URL=https://203.0.113.5/dirt
# DIRT_PUSH_USER=pushbot
