#!/bin/bash
#SBATCH -J qcapp-render
#SBATCH -o render.log
#SBATCH -t 2-00:00:00
#SBATCH -p corralextra
#SBATCH -N 1 -n 1
#SBATCH -A A2CPS

set -xeu

a2cps=/corral-secure/projects/A2CPS
release=${a2cps}/products/consortium-data/pre-surgery-release-3-0-0/mris
derivatives=${release}/derivatives

# Index every derivative tree into one bidslake catalog. Related files (a mask's
# T1w, a field map's IntendedFor bold + boldref + transform) are then resolved by
# BIDS concept at render time, across trees, from this single catalog. FreeSurfer
# recon-all is non-BIDS, so it uses the bidslake FreeSurfer adapter and indexes as
# its own dataset (its sourcedata/ nesting defeats the term-map anchor otherwise).
catalog=/scratch/08266/psadil/qcapp/a2cps.duckdb
bidslake index -i "${derivatives}/fmriprep" -o "${catalog}"
bidslake index -i "${derivatives}/synthstrip" -o "${catalog}"
bidslake index -i "${derivatives}/qsirecon_fsl_dtifit/dtifit/multishell" \
	--dataset-id dtifit -o "${catalog}"
bidslake index -i "${derivatives}/freesurfer" --adapter freesurfer \
	--dataset-id freesurfer -o "${catalog}"

# Render every step present in the catalog, updating in place. One process is the
# sole SQLite writer; rendering fans out across worker processes internally.
# The psadil/dirt:manage image ships the `bidslake` CLI and depends on bidslake by
# git rev, so `bidslake index` above can also run inside the container if desired.
apptainer run \
	--bind /scratch/08266/psadil/qcapp/a2cps.duckdb:/tmp/a2cps.duckdb \
	--bind "${a2cps}" \
	--env-file=.env \
	docker://psadil/dirt:manage \
	render --update /tmp/a2cps.duckdb
